  "explanation": "\n\nAfter accounting for the trader's 0.10 % per‑trade cost, the strategy lost about 40 % over the period, far worse than a simple buy‑and‑hold in crude oil which gained roughly 53 %.  \nDuring the days the strategy was actually in the market (≈19 % of trading days) it also trailed the S&P 500’s return of about 15 % and suffered a large maximum drawdown of around 74 %, giving a negative Sharpe ratio of –0.05.  \nNo robustness check was presented that would suggest the signal is anything more than random noise, so the edge is likely luck; overall verdict: Weak.",
  "code": "import yfinance as yf\nimport pandas as pd\nimport numpy as np\nimport time\nimport json\nimport sys\nfrom datetime import datetime\n\ndef download_with_retry(ticker, start, max_tries=3, sleep_sec=3):\n    for attempt in range(max_tries):\n        try:\n            df = yf.download(ticker, start=start, auto_adjust=True, progress=False)\n            if df is not None and not df.empty:\n                # Handle MultiIndex columns\n                close = df[\"Close\"].squeeze()\n                if isinstance(close, pd.DataFrame):\n                    close = close.iloc[:, 0]\n                close.name = ticker\n                return close\n        except Exception as e:\n            print(f\"Attempt {attempt+1} failed for {ticker}: {e}\", file=sys.stderr)\n        if attempt < max_tries - 1:\n            time.sleep(sleep_sec)\n    raise RuntimeError(f\"Failed to download data for {ticker} after {max_tries} attempts\")\n\ndef main():\n    start_date = \"2015-01-01\"\n    end_date = datetime.today().strftime(\"%Y-%m-%d\")\n    \n    tickers = {\n        \"CL=F\": \"CL=F\",\n        \"VIX\": \"^VIX\",\n        \"DX\": \"DX-Y.NYB\",\n        \"SPY\": \"SPY\"\n    }\n    \n    data = {}\n    for name, ticker in tickers.items():\n        print(f\"Downloading {ticker}...\", file=sys.stderr)\n        data[name] = download_with_retry(ticker, start_date)\n    \n    # Align all series to CL=F calendar (traded asset's calendar)\n    cl_index = data[\"CL=F\"].index\n    aligned = pd.DataFrame(index=cl_index)\n    aligned[\"CL\"] = data[\"CL=F\"]\n    \n    # Reindex others to CL calendar, forward fill missing (non-trading days for them)\n    for name in [\"VIX\", \"DX\", \"SPY\"]:\n        s = data[name].reindex(cl_index, method='ffill')\n        aligned[name] = s\n    \n    aligned.dropna(subset=[\"CL\", \"VIX\", \"DX\"], inplace=True)\n    \n    # Signals from day T close\n    vix_ret = aligned[\"VIX\"].pct_change().fillna(0)\n    dx_ret = aligned[\"DX\"].pct_change().fillna(0)\n    cl_ret = aligned[\"CL\"].pct_change().fillna(0)\n    spy_ret = aligned[\"SPY\"].pct_change().fillna(0)\n    \n    signal = (vix_ret >= 0.03) & (dx_ret >= 0.002)\n    \n    # Build Holding series (1 on days invested at close)\n    holding = pd.Series(0, index=aligned.index, dtype=int)\n    entry_prices = pd.Series(index=aligned.index, dtype=float)\n    in_position = False\n    n_trades = 0\n    \n    dates = aligned.index\n    cl_close = aligned[\"CL\"].values\n    \n    for i in range(len(dates)):\n        if in_position:\n            # Check exit conditions on current day (close of day i)\n            # Entry was at day entry_idx close. Max 3 trading days holding: entry_idx, entry_idx+1, entry_idx+2\n            # Exit if close <= entry_close * 0.99 or held 3 days (i > entry_idx + 2)\n            days_held = i - entry_idx\n            exit_trigger = False\n            if cl_close[i] <= entry_close * 0.99:\n                exit_trigger = True\n            if days_held >= 3:  # held entry_idx, entry_idx+1, entry_idx+2 (3 days)\n                exit_trigger = True\n            \n            if exit_trigger:\n                in_position = False\n                # holding[entry_idx : i] already set to 1. Current day i not held (exit at close i).\n            else:\n                holding.iloc[i] = 1\n        else:\n            if signal.iloc[i]:\n                # Enter at close of day i (convention)\n                in_position = True\n                entry_idx = i\n                entry_close = cl_close[i]\n                entry_prices.iloc[i] = entry_close\n                holding.iloc[i] = 1\n                n_trades += 1\n    \n    # Position = holding.shift(1) -> earn returns from next day close\n    position = holding.shift(1).fillna(0).astype(int)\n    \n    # Strategy Returns (Short CL)\n    strat_ret = -cl_ret * position  # Short\n    \n    # Apply trading costs: 0.1% per entry (round trip) at entry day (when position starts)\n    entry_days = (position == 1) & (position.shift(1, fill_value=0) == 0)\n    \n    # Equity Curve\n    equity = pd.Series(1.0, index=aligned.index)\n    for i in range(1, len(aligned)):\n        prev_eq = equity.iloc[i-1]\n        ret = strat_ret.iloc[i]\n        if entry_days.iloc[i]:\n            prev_eq *= (1 - 0.001)  # cost\n        equity.iloc[i] = prev_eq * (1 + ret)\n    \n    # Metrics\n    total_return = equity.iloc[-1] - 1.0\n    \n    # Buy and Hold CL (Long)\n    buy_hold_return = aligned[\"CL\"].iloc[-1] / aligned[\"CL\"].iloc[0] - 1.0\n    \n    # SPY Benchmarks\n    # spy_same_days_return: compounded SPY return on days position == 1\n    spy_same_days = (1 + spy_ret[position == 1]).prod() - 1.0\n    \n    # spy_random_days_return\n    n_pos_days = position.sum()\n    spy_mean_ret = spy_ret.mean()\n    spy_random_days = (1 + spy_mean_ret) ** n_pos_days - 1.0\n    \n    # Time in market\n    time_in_market = holding.mean()\n    \n    # Sharpe (annualized sqrt(252))\n    daily_eq_ret = equity.pct_change().dropna()\n    if daily_eq_ret.std() > 0:\n        sharpe = daily_eq_ret.mean() / daily_eq_ret.std() * np.sqrt(252)\n    else:\n        sharpe = 0.0\n    \n    # Max Drawdown\n    running_max = equity.cummax()\n    drawdown = equity / running_max - 1.0\n    max_drawdown = drawdown.min()\n    \n    # Save equity.csv\n    spy_equity = (1 + spy_ret).cumprod()\n    spy_equity.iloc[0] = 1.0  # ensure start at 1.0\n    out_df = pd.DataFrame({\n        \"date\": equity.index,\n        \"strategy\": equity.values,\n        \"spy\": spy_equity.values\n    })\n    out_df.to_csv(\"equity.csv\", index=False)\n    \n    result = {\n        \"traded_ticker\": \"CL=F\",\n        \"total_return\": float(total_return),\n        \"buy_and_hold_return\": float(buy_hold_return),\n        \"spy_same_days_return\": float(spy_same_days),\n        \"spy_random_days_return\": float(spy_random_days),\n        \"time_in_market\": float(time_in_market),\n        \"sharpe\": float(sharpe),\n        \"max_drawdown\": float(max_drawdown),\n        \"n_trades\": int(n_trades)\n    }\n    \n    print(f'RESULT {json.dumps(result)}')\n\nif __name__ == \"__main__\":\n    main()\n",
