{
  "date": "2026-11-26T17:38:57+00:00",
  "cost": 0.001,
  "hypothesis": "Enter a long position in TLT at the open of the next trading day when the US 10‑year Treasury yield (^TNX) closes down ≥ 5 basis points and the CBOE Volatility Index (^VIX) closes up ≥ 2% versus the prior close; exit when TLT closes ≥ 1% above the entry‑day’s close or after three trading days, whichever occurs first.",
  "sources": [
    {
      "title": "Markets Don't Believe Hot US Economic Data. What's the Problem?",
      "url": "https://www.tastylive.com/news-insights/markets-don-t-believe-hot-us-economic-data-what-s-the-problem"
    },
