  "result": {
    "traded_ticker": "TLT",
    "total_return": -0.35886767784671403,
    "buy_and_hold_return": -0.09807455951759847,
    "spy_same_days_return": 0.3660763438926493,
    "spy_random_days_return": 0.36568654783191157,
    "time_in_market": 0.1917808219178082,
    "sharpe": -0.43314764123852373,
    "max_drawdown": -0.4220109024435109,
    "n_trades": 144
  },
  "explanation": "\n\nAfter accounting for the 0.10 % per‑trade cost, the strategy lost about 36 % while a simple buy‑and‑hold of TLT lost only 10 % and an S&P 500 exposure limited to the same trading days would have gained roughly 37 %. Its Sharpe ratio was –0.43, the maximum drawdown exceeded –42 %, and it was invested only about one‑fifth of the time, indicating a very risky and poorly performing approach. No robustness check was reported, so the negative edge is most likely due to chance rather than a genuine signal; therefore the overall assessment is Weak.",
  "code": "import yfinance as yf\nimport pandas as pd\nimport numpy as np\nimport time\nimport json\nimport sys\n\ndef download_with_retry(ticker, start_date, max_attempts=3, sleep_time=3):\n    for attempt in range(max_attempts):\n        try:\n            df = yf.download(ticker, start=start_date, auto_adjust=True, progress=False)\n            if df is None or df.empty:\n                raise ValueError(\"Empty DataFrame\")\n            close = df[\"Close\"].squeeze()\n            if isinstance(close, pd.DataFrame):\n                close = close.iloc[:, 0]\n            close.name = ticker\n            return close\n        except Exception as e:\n            if attempt == max_attempts - 1:\n                raise RuntimeError(f\"Failed to download {ticker} after {max_attempts} attempts: {e}\")\n            time.sleep(sleep_time)\n    raise RuntimeError(f\"Failed to download {ticker}\")\n\ndef main():\n    start_date = \"2015-01-01\"\n    traded_ticker = \"TLT\"\n    bench_ticker = \"SPY\"\n\n    # Download data\n    try:\n        tlt_close = download_with_retry(traded_ticker, start_date)\n        tnx_close = download_with_retry(\"^TNX\", start_date)\n        vix_close = download_with_retry(\"^VIX\", start_date)\n        spy_close = download_with_retry(bench_ticker, start_date)\n    except Exception as e:\n        print(f'RESULT {{\"unsupported\": \"Failed to download required price data: {e}\"}}')\n        sys.exit(1)\n\n    # Align to TLT calendar (traded asset's own calendar)\n    # Forward fill non-trading days for indices/benchmarks\n    tnx_close = tnx_close.reindex(tlt_close.index).ffill()\n    vix_close = vix_close.reindex(tlt_close.index).ffill()\n    spy_close = spy_close.reindex(tlt_close.index).ffill()\n\n    # Drop leading NaNs (before data starts for any series)\n    # Use the first valid index of the traded asset as anchor\n    first_valid = tlt_close.first_valid_index()\n    if first_valid is None:\n        print('RESULT {\"unsupported\": \"Traded asset TLT has no valid data\"}')\n        sys.exit(1)\n    \n    tlt_close = tlt_close.loc[first_valid:]\n    tnx_close = tnx_close.loc[first_valid:]\n    vix_close = vix_close.loc[first_valid:]\n    spy_close = spy_close.loc[first_valid:]\n\n    # Compute Signals on day T (using TLT index)\n    # TNX: closes down >= 5 bps (0.05 yield points)\n    tnx_chg = tnx_close.diff()\n    # VIX: closes up >= 2%\n    vix_pct_chg = vix_close.pct_change()\n\n    signal = (tnx_chg <= -0.05) & (vix_pct_chg >= 0.02)\n    signal = signal.fillna(False).astype(bool)\n\n    # Generate Holding Periods (Vectorized State Machine)\n    n = len(tlt_close)\n    holding = np.zeros(n, dtype=bool)\n    entry_price_arr = np.full(n, np.nan)\n    \n    tlt_vals = tlt_close.values\n    sig_vals = signal.values\n    \n    i = 0\n    while i < n:\n        if sig_vals[i]:\n            entry_idx = i\n            entry_px = tlt_vals[i]\n            target_px = entry_px * 1.01\n            \n            # Max hold 3 trading days: check exit at close of T+1, T+2, T+3 (indices i+1, i+2, i+3)\n            max_check_idx = min(i + 3, n - 1)\n            exit_idx = max_check_idx # Default to max holding (exit at T+3 close)\n            found_exit = False\n            \n            for j in range(i + 1, max_check_idx + 1):\n                if tlt_vals[j] >= target_px:\n                    exit_idx = j\n                    found_exit = True\n                    break\n            \n            # Holding includes entry day (i) through exit day (exit_idx) inclusive\n            # We are invested from entry close to exit close.\n            end_hold = exit_idx + 1 # slice end is exclusive\n            holding[entry_idx:end_hold] = True\n            entry_price_arr[entry_idx:end_hold] = entry_px\n            \n            # Jump to day after exit to avoid overlapping trades (flat until next signal)\n            i = exit_idx + 1\n        else:\n            i += 1\n\n    # Position: earn close-to-close returns from T+1. position = holding.shift(1)\n    position = np.roll(holding, 1)\n    position[0] = False\n\n    # Daily Returns\n    tlt_ret = tlt_close.pct_change().fillna(0).values\n    spy_ret = spy_close.pct_change().fillna(0).values\n\n    # Strategy Daily Returns\n    strat_ret = position * tlt_ret\n    \n    # Costs: 0.1% round trip on every entry (first day of position)\n    entry_days = position & (~np.roll(position, 1))\n    entry_days[0] = False\n    strat_ret[entry_days] -= 0.001\n\n    # Equity Curves (Start at 1.0 on first date)\n    strat_eq = (1 + pd.Series(strat_ret, index=tlt_close.index)).cumprod()\n    spy_eq = (1 + pd.Series(spy_ret, index=tlt_close.index)).cumprod()\n    tlt_eq = (1 + pd.Series(tlt_ret, index=tlt_close.index)).cumprod() # For buy_and_hold_return\n\n    # Metrics\n    total_return = float(strat_eq.iloc[-1] - 1.0)\n    buy_and_hold_return = float(tlt_eq.iloc[-1] - 1.0) # Traded asset (TLT) buy and hold\n\n    # SPY Same Days Return: compounded SPY return over only days strategy held a position (position mask)\n    held_spy_ret = spy_ret[position]\n    if len(held_spy_ret) > 0:\n        spy_same_days_return = float(np.prod(1 + held_spy_ret) - 1)\n    else:\n        spy_same_days_return = 0.0\n\n    # SPY Random Days Return: (1 + mean daily SPY return over full period) ** (number of days in a position) - 1\n    n_days_held = int(position.sum())\n    mean_spy_ret = float(np.mean(spy_ret))\n    if n_days_held > 0:\n        spy_random_days_return = float((1 + mean_spy_ret) ** n_days_held - 1)\n    else:\n        spy_random_days_return = 0.0\n\n    # Time in Market: fraction of days the strategy held a position (holding days / total days)\n    time_in_market = float(holding.sum() / n)\n\n    # Sharpe (Annualized sqrt(252) for non-crypto)\n    daily_ret_series = pd.Series(strat_ret).replace([np.inf, -np.inf], np.nan).dropna()\n    if daily_ret_series.std() > 0:\n        sharpe = float(daily_ret_series.mean() / daily_ret_series.std() * np.sqrt(252))\n    else:\n        sharpe = 0.0\n\n    # Max Drawdown\n    running_max = strat_eq.cummax()\n    drawdown = strat_eq / running_max - 1\n    max_drawdown = float(drawdown.min())\n\n    # Number of Trades: number of entries (position opening from flat)\n    n_trades = int(entry_days.sum())\n\n    # Save Equity Curve\n    equity_df = pd.DataFrame({\n        'date': strat_eq.index,\n        'strategy': strat_eq.values,\n        'spy': spy_eq.values\n    })\n    equity_df.to_csv('equity.csv', index=False)\n\n    # Result JSON\n    result = {\n        \"traded_ticker\": traded_ticker,\n        \"total_return\": total_return,\n        \"buy_and_hold_return\": buy_and_hold_return,\n        \"spy_same_days_return\": spy_same_days_return,\n        \"spy_random_days_return\": spy_random_days_return,\n        \"time_in_market\": time_in_market,\n        \"sharpe\": sharpe,\n        \"max_drawdown\": max_drawdown,\n        \"n_trades\": n_trades\n    }\n    print(f'RESULT {json.dumps(result)}')\n\nif __name__ == \"__main__\":\n    main()\n",
